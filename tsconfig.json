{
    "compilerOptions": {
      "target": "es2022",
      "module": "commonjs",
      "rootDir": "src",
      "resolveJsonModule": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "outDir": "dist",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "paths": {
        "@handlers/*": ["./src/classes/handlers/*"],
        "@managers/*": ["./src/classes/managers/*"],
        "@structures/*": ["./src/classes/structures/*"],
        "@utils/*": ["./src/utils/*"],
      }
    }
}